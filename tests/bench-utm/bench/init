#!/bin/sh
# /init for the QEMU guests: run the workloads named by bench=a,b,c on the kernel command line, then power off.
mkdir -p /proc /sys /dev /tmp
mount -t devtmpfs dev /dev
exec </dev/console >/dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sys /sys
B=none
for x in $(cat /proc/cmdline); do case $x in bench=*) B=${x#bench=} ;; esac; done
echo "BENCH-START $(uname -m) $(uname -r) $B"
/bench/run1.sh $(echo "$B" | tr , ' ')
echo BENCH-END
poweroff -f
